                {
                    Return (Ones)
                }

                If (\_SB.I2C5.AVBL)
                {
                    Name (BUFF, Buffer (0x10){})
                    CreateWordField (BUFF, Zero, YEAR)
                    CreateByteField (BUFF, 0x02, MNTH)
                    CreateByteField (BUFF, 0x03, DAYS)
                    CreateByteField (BUFF, 0x04, HOUR)
                    CreateByteField (BUFF, 0x05, MINS)
                    CreateByteField (BUFF, 0x06, SECD)
                    BUFF = _GRT ()
                    Local0 = TTS (BUFF)
                    SPBB = \_SB.I2C5.ASEC
                    FromBCD (DAT0, SECD) /* \_SB_.RTCD._TIV.SECD */
                    SPBB = \_SB.I2C5.AMIN
                    FromBCD (DAT0, MINS) /* \_SB_.RTCD._TIV.MINS */
                    SPBB = \_SB.I2C5.AHRS
                    FromBCD (DAT0, HOUR) /* \_SB_.RTCD._TIV.HOUR */
                    SPBB = \_SB.I2C5.ADAY
                    FromBCD (DAT0, DAYS) /* \_SB_.RTCD._TIV.DAYS */
                    SPBB = \_SB.I2C5.AMNT
                    FromBCD (DAT0, MNTH) /* \_SB_.RTCD._TIV.MNTH */
                    SPBB = \_SB.I2C5.AYRS
                    FromBCD (DAT0, Local0)
                    YEAR = (Local0 + 0x07D0)
                    Local1 = TTS (BUFF)
                    REMT = (Local1 - Local0)
                    Return (TIVR) /* \_SB_.RTCD._TIV.TIVR */
                }
                Else
                {
                    Return (Ones)
                }
            }

            Method (STT, 1, NotSerialized)
            {
                Name (BUFF, Buffer (0x10){})
                CreateWordField (BUFF, Zero, YEAR)
                CreateByteField (BUFF, 0x02, MNTH)
                CreateByteField (BUFF, 0x03, DAYS)
                CreateByteField (BUFF, 0x04, HOUR)
                CreateByteField (BUFF, 0x05, MINS)
                CreateByteField (BUFF, 0x06, SECD)
                CreateByteField (BUFF, 0x07, PAD1)
                CreateWordField (BUFF, 0x08, MSEC)
                CreateWordField (BUFF, 0x0A, TZON)
                CreateByteField (BUFF, 0x0C, DLGT)
                CreateByteField (BUFF, 0x0D, PAD2)
                CreateDWordField (Arg0, Zero, SECS)
                Local0 = SECS /* \_SB_.RTCD.STT_.SECS */
                SECD = (Local0 % 0x3C)
                Local0 /= 0x3C
                MINS = (Local0 % 0x3C)
                Local0 /= 0x3C
                HOUR = (Local0 % 0x18)
                Local0 /= 0x18
                Local4 = (Local0 / 0x016D)
                Local0++
                Local5 = Zero
                While ((Local5 <= Zero))
                {
                    Local4--
                    Local5 = (Local4 / 0x04)
                    Local6 = (Local5 + One)
                    Local5 = (Local4 / 0x64)
                    Local6 -= Local5
                    Local5 = (Local4 / 0x0190)
                    Local6 += Local5
                    Local4++
                    Local5 = (Local4 * 0x016D)
                    Local5 = (Local0 - Local5)
                    Local5 -= Local6
                    Local4--
                }

                YEAR = (Local4 + 0x07D1)
                Local6 = One
                Local7 = One
                While ((Local7 <= 0x0C))
                {
                    If ((Match (Package (0x07)
                                    {
                                        One, 
                                        0x03, 
                                        0x05, 
                                        0x07, 
                                        0x08, 
                                        0x0A, 
                                        0x0C
                                    }, MEQ, Local7, MTR, Zero, Zero) != Ones))
                    {
                        Local6 = 0x1F
                    }
                    ElseIf ((Match (Package (0x04)
                                    {
                                        0x04, 
                                        0x06, 
                                        0x09, 
                                        0x0B
                                    }, MEQ, Local7, MTR, Zero, Zero) != Ones))
                    {
                        Local6 = 0x1E
                    }
                    ElseIf ((Local7 == 0x02))
                    {
                        If ((((YEAR % 0x0190) || (YEAR % 0x04)) && (
                            YEAR % 0x64)))
                        {
                            Local6 = 0x1C
                        }
                        Else
                        {
                            Local6 = 0x1D
                        }
                    }

                    If ((Local5 > Local6))
                    {
                        Local5 -= Local6
                    }
                    Else
                    {
                        Break
                    }

                    Local7++
                }

                MNTH = Local7
                DAYS = Local5
                Return (BUFF) /* \_SB_.RTCD.STT_.BUFF */
            }

            Method (TTS, 1, NotSerialized)
            {
                CreateWordField (Arg0, Zero, YEAR)
                CreateByteField (Arg0, 0x02, MNTH)
                CreateByteField (Arg0, 0x03, DAYS)
                CreateByteField (Arg0, 0x04, HOUR)
                CreateByteField (Arg0, 0x05, MINS)
                CreateByteField (Arg0, 0x06, SECD)
                CreateByteField (Arg0, 0x0A, TZON)
                CreateByteField (Arg0, 0x0C, DLGT)
                Local0 = Zero
                Local1 = (YEAR - One)
                While ((Local1 >= 0x07D0))
                {
                    Local0 += 0x01E13380
                    If (!(((Local1 % 0x0190) || (Local1 % 0x64)) && 
                        (Local1 % 0x04)))
                    {
                        Local0 += 0x00015180
                    }

                    Local1--
                }

                Local1 = One
                While ((Local1 < MNTH))
                {
                    If ((Match (Package (0x07)
                                    {
                                        One, 
                                        0x03, 
                                        0x05, 
                                        0x07, 
                                        0x08, 
                                        0x0A, 
                                        0x0C
                                    }, MEQ, Local1, MTR, Zero, Zero) != Ones))
                    {
                        Local0 += 0x0028DE80
                    }
                    ElseIf ((Match (Package (0x04)
                                    {
                                        0x04, 
                                        0x06, 
                                        0x09, 
                                        0x0B
                                    }, MEQ, Local1, MTR, Zero, Zero) != Ones))
                    {
                        Local0 += 0x00278D00
                    }
                    ElseIf ((Local1 == 0x02))
                    {
                        If ((((YEAR % 0x0190) || (YEAR % 0x64)) && (
                            YEAR % 0x04)))
                        {
                            Local0 += 0x0024EA00
                        }
                        Else
                        {
                            Local0 += 0x00263B80
                        }
                    }

                    Local1++
                }

                Local1 = (DAYS - One)
                Local1 *= 0x00015180
                Local0 += Local1
                Local1 = (HOUR * 0x0E10)
                Local0 += Local1
                Local1 = (HOUR * 0x3C)
                Local0 += Local1
                Local0 += SECD /* \_SB_.RTCD.TTS_.SECD */
                Name (BUFF, Buffer (0x04){})
                BUFF = Local0
                Return (BUFF) /* \_SB_.RTCD.TTS_.BUFF */
            }

