            CreateByteField (BUF0, 0x03, STA1)
            Method (_PSR, 0, NotSerialized)  // _PSR: Power Source
            {
                If ((\_SB.I2C5.AVBL != Zero))
                {
                    If ((\_SB.I2Z1.AVBL != Zero))
                    {
                        If ((\_SB.BDID > 0x07))
                        {
                            If ((\_SB.I2Z1.DVER > Zero))
                            {
                                Local0 = MAGP /* \_SB_.ADP0.MAGP */
                                If ((Local0 != Zero))
                                {
                                    Debug = "******* AC In"
                                    Acquire (\_SB.GPIO.TOGG, 0xFFFF)
                                    ^TSCG = One
                                    Release (\_SB.GPIO.TOGG)
                                    Return (One)
                                }
                                Else
                                {
                                    Debug = "******* AC out"
                                    Acquire (\_SB.GPIO.TOGG, 0xFFFF)
                                    ^TSCG = Zero
                                    Release (\_SB.GPIO.TOGG)
                                    Return (Zero)
                                }
                            }
                        }

                        ^BUF0 = \_SB.BAT0.RSPB (0x03, 0x07, Zero)
                        If ((STA0 != Zero))
                        {
                            Local0 = (STA1 & 0x02)
                            If (Local0)
                            {
                                Debug = "******* AC In"
                                Acquire (\_SB.GPIO.TOGG, 0xFFFF)
                                ^TSCG = One
                                Release (\_SB.GPIO.TOGG)
                                Return (One)
                            }
                        }
                    }
                }

                Debug = "******* AC out"
                Acquire (\_SB.GPIO.TOGG, 0xFFFF)
                ^TSCG = Zero
                Release (\_SB.GPIO.TOGG)
                Return (Zero)
            }
        }

        Device (BAT0)
