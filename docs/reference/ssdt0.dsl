                    Local4 = VAL7 /* \_SB_.BAT0._BIX.VAL7 */
                    Local5 = VALE /* \_SB_.BAT0._BIX.VALE */
                    Local6 = VALF /* \_SB_.BAT0._BIX.VALF */
