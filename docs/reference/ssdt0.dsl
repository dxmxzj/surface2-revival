            CreateByteField (I2CB, 0x03, BYT2)
            Name (I2CC, Buffer (0x22){})
            CreateByteField (I2CC, 0x02, DAT0)
            Method (SGIO, 1, Serialized)
            {
                CreateByteField (Arg0, Zero, INDX)
                CreateBitField (Arg0, 0x08, ACT)
                CreateBitField (Arg0, 0x09, STA)
                While (One)
