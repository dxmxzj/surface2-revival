                Debug = BIX0 [0x03]
                Debug = BIX0 [0x04]
                Debug = BIX0 [0x05]
                Debug = BIX0 [0x06]
                Debug = BIX0 [0x07]
                Debug = BIX0 [0x08]
                Debug = BIX0 [0x09]
                Debug = BIX0 [0x0A]
                Debug = BIX0 [0x0B]
                Debug = BIX0 [0x0C]
                Debug = BIX0 [0x0D]
