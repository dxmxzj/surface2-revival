                                {
                                    ^LEN = 0x02
                                    ^BYT1 = 0x12
                                    ^BYT2 = Zero
                                    \_SB.I2C5.FLD0 = ^I2CB /* \_SB_.GFXC.I2CB */
                                    I2CC = \_SB.I2C5.FET1
                                    ^DAT0 &= 0xFE
                                    \_SB.I2C5.FET1 = I2CC /* \_SB_.GFXC.I2CC */
                                }
