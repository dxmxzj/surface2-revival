                    {
                        If ((Arg2 == One))
                        {
                            Debug = "Trigger ADP0, 0x80:"
                            Notify (\_SB.ADP0, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x02))
                        {
                            Debug = "Trigger BAT0, 0x80:"
                            Notify (\_SB.BAT0, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x03))
                        {
                            Debug = "Trigger BAT1, 0x80:"
                            Notify (\_SB.BAT1, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x04))
                        {
                            Debug = "Trigger ADP0, 0x81:"
                            Notify (\_SB.ADP0, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x05))
                        {
                            Debug = "Trigger BAT0, 0x81:"
                            Notify (\_SB.BAT0, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x06))
                        {
                            Debug = "Trigger BAT1, 0x81:"
                            Notify (\_SB.BAT1, 0x81) // Information Change
                        }
                    }

                    If ((Arg1 == One))
                    {
                        If ((Arg2 == One))
                        {
                            Debug = "Trigger ADP0, 0x80:"
                            Notify (\_SB.ADP0, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x02))
                        {
                            Debug = "Trigger BAT0, 0x80:"
                            Notify (\_SB.BAT0, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x03))
                        {
                            Debug = "Trigger BAT1, 0x80:"
                            Notify (\_SB.BAT1, 0x80) // Status Change
                        }

                        If ((Arg2 == 0x04))
                        {
                            Debug = "Trigger ADP0, 0x81:"
                            Notify (\_SB.ADP0, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x05))
                        {
                            Debug = "Trigger BAT0, 0x81:"
                            Notify (\_SB.BAT0, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x06))
                        {
                            Debug = "Trigger BAT1, 0x81:"
                            Notify (\_SB.BAT1, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x07))
                        {
                            Debug = "Trigger BAT1, 0x00:"
                            Notify (\_SB.BAT1, Zero) // Bus Check
                            Debug = "Trigger BAT1, 0x81:"
                            Notify (\_SB.BAT1, 0x81) // Information Change
                        }

                        If ((Arg2 == 0x08))
