                            Debug = "Trigger BAT1, 0x03:"
                            Notify (\_SB.BAT1, 0x03) // Eject Request
                            Debug = "Trigger BAT1, 0x81:"
                            Notify (\_SB.BAT1, 0x81) // Information Change
