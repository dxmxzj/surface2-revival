                                    I2CC = \_SB.I2C5.FET1
                                    ^DAT0 |= 0x03
                                    \_SB.I2C5.FET1 = I2CC /* \_SB_.GFXC.I2CC */
                                    ^LEN = 0x02
                                    ^BYT1 = 0x12
                                    ^BYT2 = 0x03
                                    \_SB.I2C5.FLD0 = ^I2CB /* \_SB_.GFXC.I2CB */
                                    If ((\_SB.BDID == One))
