[Unit]
Description=Surface 2 Panel TPS65090 FET4 Power-Cycle Recovery
DefaultDependencies=no
After=local-fs.target
Before=surface-touch-init.service surface-touch-kbd.service surface-dashboard.service graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/surface-panel-reset.py

[Install]
WantedBy=basic.target
